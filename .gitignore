# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
*.tsbuildinfo

# ── SQLite database ───────────────────────────────────────────────────────────
data/
*.db
*.sqlite
*.sqlite3

# ── SSH keys — NEVER commit private keys ─────────────────────────────────────
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
smoggle_ed25519
# Public keys are fine to commit if needed, but exclude by default
*.pub

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep Dockerfile, compose.yaml, and .dockerignore tracked
# Exclude any local override files
compose.override.yaml
docker-compose.override.yml

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
